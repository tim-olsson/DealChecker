# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Only GOOGLE_API_KEY is required; everything else is optional.

# --- Gemini (required) --------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Google Cloud project (needed for any cloud feature below) ------------------
# Also run: gcloud auth application-default login
#           bash scripts/enable_apis.sh <project-id>
GOOGLE_CLOUD_PROJECT=
# Set to false if the gcloud mTLS client-certificate helper fails on your machine.
# GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# --- Sessions + Memory Bank (Vertex AI Agent Engine) ----------------------------
# From: uv run scripts/create_agent_engine.py --project <id> --location <region>
# Unset = local SQLite sessions (.adk/sessions.db) and no long-term memory.
# SESSION_SERVICE_URI=agentengine://projects/<number>/locations/<region>/reasoningEngines/<id>
# MEMORY_SERVICE_URI=agentengine://projects/<number>/locations/<region>/reasoningEngines/<id>

# --- Guardrails: Model Armor ---------------------------------------------------
# From: uv run scripts/create_model_armor_templates.py --project <id> --location <region>
# Unset = Model Armor screening off (input policy + safety settings still apply).
# MODEL_ARMOR_PROMPT_TEMPLATE=projects/<id>/locations/<region>/templates/deal-checker-input
# MODEL_ARMOR_RESPONSE_TEMPLATE=projects/<id>/locations/<region>/templates/deal-checker-output

# --- Observability --------------------------------------------------------------
LOG_FORMAT=json            # json | text
LOG_LEVEL=INFO
LOG_TO_CLOUD=false         # true = also send to Cloud Logging (log "deal-checker")
TRACE_TO_CLOUD=false       # true = export spans to Cloud Trace (adk web: --otel_to_cloud)
# LOG_CONTENT=false        # true = include prompt/response text in logs/spans (local debugging only)
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
